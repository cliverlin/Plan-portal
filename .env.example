# 공개 Google Drive 폴더 조회용 API key (서버 전용, 브라우저에 노출 금지)
GOOGLE_DRIVE_API_KEY=replace-with-google-drive-api-key

# 이 폴더와 그 하위 경로만 탐색·게시할 승인된 Google Drive 폴더 ID
GOOGLE_DRIVE_FOLDER_ID=1nvXxRHtqv9ibQN-mM46o-NVW_GdhTKq5

# 별도 Netlify 사이트로 배포한 HTML 실행 전용 출처(끝의 / 제외)
DRIVE_RUNNER_ORIGIN=https://your-ok-plan-runner.netlify.app

# 선택: HTML·이미지 상한(byte), 기본 20 MB(decimal). 1~20000000 범위에서 하향 조정.
# 예전 5242880 설정이 남아 있으면 5 MiB 제한이 계속 적용됨.
DRIVE_MAX_FILE_BYTES=20000000
