# Google OAuth 2.0 (서버 전용, 브라우저에 노출 금지)
GOOGLE_OAUTH_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-with-refresh-token

# 직접 하위 파일만 게시할 승인된 Google Drive 폴더 ID
GOOGLE_DRIVE_FOLDER_ID=replace-with-folder-id

# 별도 Netlify 사이트로 배포한 HTML 실행 전용 출처(끝의 / 제외)
DRIVE_RUNNER_ORIGIN=https://your-ok-plan-runner.netlify.app

# 선택: 실행할 HTML 한 파일의 최대 크기(byte), 기본 5 MiB
DRIVE_MAX_FILE_BYTES=5242880
